# Dream Kitchen environment variables. Copy to .env for local development; NEVER commit .env.
# On the live site these go in Netlify -> Site configuration -> Environment variables
# (docs/SETUP-BACKEND.md says exactly which values to paste). None of them reach the browser.

# --- Supabase (database, admin login, private photo storage) ---
SUPABASE_URL=
# Project Settings -> API Keys -> Publishable key (sb_publishable_..., or the legacy "anon" key).
# Used only by the admin login, on the server.
SUPABASE_ANON_KEY=
# Project Settings -> API Keys -> Secret key (sb_secret_..., or the legacy "service_role" key).
# SECRET: full database access. Netlify only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend, free tier) ---
RESEND_API_KEY=
# Sender. Until you verify a domain in Resend, keep the default test sender (it can only email
# the address you signed up to Resend with).
EMAIL_FROM=Dream Kitchen <onboarding@resend.dev>
# Where Hema's new-order, class booking and message emails go (she can change it in admin Settings)
HEMA_EMAIL=

# --- Payment ---
# UPI: only the fallback while Razorpay isn't set up. Hema's UPI ID (or set it in admin Settings).
# No Razorpay and no UPI = "Online ordering opens soon - WhatsApp us".
UPI_ID=
# Razorpay: the main way to pay, ON as soon as both keys are set (rzp_test_... first, then rzp_live_...).
# Webhook: https://<site>/api/razorpay-webhook, events payment.captured + order.paid, and its secret here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Local development only (ignored on Netlify) ---
# Without SUPABASE_URL the dev server uses a mock database in .dev-data/ and writes emails to
# .dev-data/outbox/. Admin login for that mock database (pick your own; never a real password):
DK_DEV_ADMIN_EMAIL=
DK_DEV_ADMIN_PASSWORD=
